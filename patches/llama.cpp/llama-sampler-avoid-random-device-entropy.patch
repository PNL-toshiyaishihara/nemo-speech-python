From: nemo-speech-python
Subject: llama: avoid std::random_device::entropy() with libstdc++

std::random_device::entropy() resolves to _M_getentropy (GLIBCXX_3.4.25),
which the manylinux_2_28 policy does not allow. libstdc++'s random_device is
a true RNG on Linux and macOS, so the PRNG fallback check is not needed there.
---
diff --git a/src/llama-sampler.cpp b/src/llama-sampler.cpp
index b797c50..915f4db 100644
--- a/src/llama-sampler.cpp
+++ b/src/llama-sampler.cpp
@@ -340,7 +340,13 @@ static void llama_sampler_top_k_impl(llama_token_data_array * cur_p, int32_t k)
 static uint32_t get_rng_seed(uint32_t seed) {
     if (seed == LLAMA_DEFAULT_SEED) {
         // use system clock if std::random_device is not a true RNG
+#if defined(__GLIBCXX__)
+        // libstdc++'s random_device is a true RNG on every target this build
+        // supports, and entropy() needs GLIBCXX_3.4.25, newer than manylinux_2_28.
+        static bool is_rd_prng = false;
+#else
         static bool is_rd_prng = std::random_device().entropy() == 0;
+#endif
         if (is_rd_prng) {
             return (uint32_t) std::chrono::system_clock::now().time_since_epoch().count();
         }
