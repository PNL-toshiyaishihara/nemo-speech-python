+GGML_CPU_FORWARD_REQUIRED(void, ggml_cpu_fp32_to_fp16, (const float * x, ggml_fp16_t * y, int64_t n), (x, y, n))
+GGML_CPU_FORWARD_REQUIRED(void, ggml_cpu_fp16_to_fp32, (const ggml_fp16_t * x, float * y, int64_t n), (x, y, n))
+GGML_CPU_FORWARD_REQUIRED(void, ggml_cpu_fp32_to_bf16, (const float * x, ggml_bf16_t * y, int64_t n), (x, y, n))
+GGML_CPU_FORWARD_REQUIRED(void, ggml_cpu_bf16_to_fp32, (const ggml_bf16_t * x, float * y, int64_t n), (x, y, n))
