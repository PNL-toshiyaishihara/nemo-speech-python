+
+GGML_CPU_FORWARD_REQUIRED(void, ggml_cpu_init, (void), ())
+
+GGML_CPU_FORWARD(ggml_backend_t, ggml_backend_cpu_init, (void), (), return nullptr)
+
+GGML_CPU_FORWARD(bool, ggml_backend_is_cpu, (ggml_backend_t backend), (backend), return false)
