From: nemo-speech-python
Subject: ggml: load the CPU variants through a linked ggml-cpu proxy

GGML_CPU_ALL_VARIANTS builds the CPU backend once per CPU generation and
picks one at run time, but it requires GGML_BACKEND_DL, which also turns
the GPU backends into modules. NeMo-Speech.cpp links ggml-cpu, ggml-cuda
and ggml-vulkan and calls some of their functions directly, so it cannot
use GGML_BACKEND_DL.

GGML_CPU_VARIANTS_PROXY builds only the CPU variants as modules and adds a
ggml-cpu library with the API of ggml-cpu.h. It loads the best-scoring
variant from its own directory and forwards every call to it. The other
backends stay linked, and ggml registers the CPU backend statically as
before.
---
diff --git a/ggml/CMakeLists.txt b/ggml/CMakeLists.txt
index 1df78fd..fd1c0dc 100644
--- a/ggml/CMakeLists.txt
+++ b/ggml/CMakeLists.txt
@@ -181,6 +181,7 @@ option(GGML_XTHEADVECTOR     "ggml: enable xtheadvector"      OFF)
 option(GGML_VXE              "ggml: enable vxe"               ${GGML_NATIVE})
 
 option(GGML_CPU_ALL_VARIANTS "ggml: build all variants of the CPU backend (requires GGML_BACKEND_DL)" OFF)
+option(GGML_CPU_VARIANTS_PROXY "ggml: load the GGML_CPU_ALL_VARIANTS modules through a linked ggml-cpu proxy instead of GGML_BACKEND_DL" OFF)
 set(GGML_CPU_ARM_ARCH        "" CACHE STRING "ggml: CPU architecture for ARM")
 set(GGML_CPU_POWERPC_CPUTYPE "" CACHE STRING "ggml: CPU type for PowerPC")
 
diff --git a/ggml/src/CMakeLists.txt b/ggml/src/CMakeLists.txt
index 9477320..0b865d3 100644
--- a/ggml/src/CMakeLists.txt
+++ b/ggml/src/CMakeLists.txt
@@ -484,6 +484,15 @@ endfunction()
 
 ggml_add_backend(CPU)
 
+if (GGML_CPU_VARIANTS_PROXY)
+    if (NOT GGML_CPU_ALL_VARIANTS OR GGML_BACKEND_DL OR NOT BUILD_SHARED_LIBS)
+        message(FATAL_ERROR "GGML_CPU_VARIANTS_PROXY requires GGML_CPU_ALL_VARIANTS and BUILD_SHARED_LIBS, without GGML_BACKEND_DL")
+    endif()
+    # Build the variants as modules, as GGML_BACKEND_DL does; ggml-cpu-proxy.cpp
+    # loads one of them. The other backends stay linked.
+    set(GGML_BACKEND_DL ON)
+endif()
+
 if (GGML_CPU_ALL_VARIANTS)
     if (NOT GGML_BACKEND_DL)
         message(FATAL_ERROR "GGML_CPU_ALL_VARIANTS requires GGML_BACKEND_DL")
@@ -586,6 +595,26 @@ elseif (GGML_CPU)
     ggml_add_cpu_backend_variant_impl("")
 endif()
 
+if (GGML_CPU_VARIANTS_PROXY)
+    unset(GGML_BACKEND_DL)
+    if (NOT WIN32 AND NOT APPLE)
+        # The proxy exports the same functions as the variants. Bind each
+        # variant's calls to its own functions, so that they never reach the
+        # proxy when it is in the global scope (e.g. linked by the executable).
+        get_property(ggml_cpu_targets DIRECTORY PROPERTY BUILDSYSTEM_TARGETS)
+        foreach (target ${ggml_cpu_targets})
+            get_target_property(target_type ${target} TYPE)
+            if (target MATCHES "^ggml-cpu-" AND target_type STREQUAL "MODULE_LIBRARY")
+                target_link_options(${target} PRIVATE "LINKER:-Bsymbolic-functions")
+            endif()
+        endforeach()
+    endif()
+    ggml_add_backend_library(ggml-cpu ggml-cpu-proxy.cpp)
+    target_include_directories(ggml-cpu PRIVATE .)
+    target_compile_features(ggml-cpu PRIVATE cxx_std_17)
+    target_link_libraries(ggml-cpu PRIVATE ${CMAKE_DL_LIBS})
+endif()
+
 ggml_add_backend(BLAS)
 ggml_add_backend(CANN)
 ggml_add_backend(CUDA)
diff --git a/ggml/src/ggml-cpu-proxy.cpp b/ggml/src/ggml-cpu-proxy.cpp
new file mode 100644
index 0000000..2383482
--- /dev/null
+++ b/ggml/src/ggml-cpu-proxy.cpp
@@ -0,0 +1,357 @@
+// Linked stand-in for a CPU backend built per CPU generation
+// (GGML_CPU_VARIANTS_PROXY, added by nemo-speech-python).
+//
+// GGML_CPU_ALL_VARIANTS builds the CPU backend once per CPU generation
+// (ggml-cpu-haswell, ggml-cpu-alderlake, ...) and normally needs
+// GGML_BACKEND_DL, which turns every other backend into a module as well, so
+// programs can no longer link ggml-cpu or call a backend's functions directly.
+// This library takes the place of the linked ggml-cpu instead. On first use it
+// loads, from its own directory, the variant whose ggml_backend_score() is
+// highest on this CPU, and forwards every function of ggml-cpu.h to it. ggml
+// still registers the CPU backend statically, so nothing needs to load
+// backends explicitly.
+//
+// NEMO_SPEECH_CPU_VARIANT=<name> (e.g. haswell) selects a variant by name when
+// this CPU supports it.
+
+#include "ggml-backend-impl.h"
+#include "ggml-cpu.h"
+#include "ggml-impl.h"
+
+#include <algorithm>
+#include <cstdlib>
+#include <filesystem>
+#include <string>
+#include <system_error>
+#include <vector>
+
+#ifdef _WIN32
+#    define WIN32_LEAN_AND_MEAN
+#    ifndef NOMINMAX
+#        define NOMINMAX
+#    endif
+#    include <windows.h>
+#else
+#    include <dlfcn.h>
+#endif
+
+namespace fs = std::filesystem;
+
+namespace {
+
+#ifdef _WIN32
+
+using library_handle = HMODULE;
+
+const fs::path::string_type variant_prefix = L"ggml-cpu-";
+const fs::path::string_type variant_suffix = L".dll";
+
+fs::path this_library_path() {
+    HMODULE self = nullptr;
+    if (!GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+                            reinterpret_cast<LPCWSTR>(&this_library_path), &self)) {
+        return {};
+    }
+    std::wstring path(MAX_PATH, L'\0');
+    for (;;) {
+        const DWORD len = GetModuleFileNameW(self, path.data(), static_cast<DWORD>(path.size()));
+        if (len == 0) {
+            return {};
+        }
+        if (len < path.size()) {
+            path.resize(len);
+            return fs::path(path);
+        }
+        path.resize(path.size() * 2);
+    }
+}
+
+library_handle open_library(const fs::path & path) {
+    // No error dialog for a variant that cannot be loaded.
+    DWORD old_mode = 0;
+    SetThreadErrorMode(SEM_FAILCRITICALERRORS, &old_mode);
+    // Dependencies resolve next to the variant and in the process's DLL directories.
+    HMODULE handle = LoadLibraryExW(path.c_str(), nullptr,
+                                    LOAD_LIBRARY_SEARCH_DLL_LOAD_DIR | LOAD_LIBRARY_SEARCH_DEFAULT_DIRS);
+    SetThreadErrorMode(old_mode, nullptr);
+    return handle;
+}
+
+void * library_symbol(library_handle handle, const char * name) {
+    return reinterpret_cast<void *>(GetProcAddress(handle, name));
+}
+
+void close_library(library_handle handle) {
+    FreeLibrary(handle);
+}
+
+std::string library_error() {
+    return "error " + std::to_string(GetLastError());
+}
+
+#else
+
+using library_handle = void *;
+
+const fs::path::string_type variant_prefix = "libggml-cpu-";
+const fs::path::string_type variant_suffix = ".so";
+
+fs::path this_library_path() {
+    Dl_info info;
+    if (!dladdr(reinterpret_cast<void *>(&this_library_path), &info) || !info.dli_fname) {
+        return {};
+    }
+    return fs::path(info.dli_fname);
+}
+
+library_handle open_library(const fs::path & path) {
+    return dlopen(path.c_str(), RTLD_NOW | RTLD_LOCAL);
+}
+
+void * library_symbol(library_handle handle, const char * name) {
+    return dlsym(handle, name);
+}
+
+void close_library(library_handle handle) {
+    dlclose(handle);
+}
+
+std::string library_error() {
+    const char * error = dlerror();
+    return error ? error : "";
+}
+
+#endif
+
+std::string utf8(const fs::path & path) {
+#if defined(__cpp_lib_char8_t)
+    const std::u8string s = path.u8string();
+    return std::string(s.begin(), s.end());
+#else
+    return path.u8string();
+#endif
+}
+
+// "haswell" for ggml-cpu-haswell.dll / libggml-cpu-haswell.so; empty for other files.
+std::string variant_name(const fs::path & file) {
+    const fs::path::string_type name = file.filename().native();
+    if (name.size() <= variant_prefix.size() + variant_suffix.size() ||
+        name.compare(0, variant_prefix.size(), variant_prefix) != 0 ||
+        name.compare(name.size() - variant_suffix.size(), variant_suffix.size(), variant_suffix) != 0) {
+        return {};
+    }
+    return utf8(name.substr(variant_prefix.size(), name.size() - variant_prefix.size() - variant_suffix.size()));
+}
+
+struct cpu_variant {
+    library_handle     handle = nullptr;
+    ggml_backend_reg_t reg    = nullptr;
+};
+
+// The supported variant with the highest score among `files`, or none.
+cpu_variant load_best(const std::vector<fs::path> & files) {
+    library_handle best       = nullptr;
+    int            best_score = 0;
+    fs::path       best_file;
+    for (const fs::path & file : files) {
+        library_handle handle = open_library(file);
+        if (!handle) {
+            GGML_LOG_WARN("%s: cannot load %s: %s\n", __func__, utf8(file).c_str(), library_error().c_str());
+            continue;
+        }
+        auto score_fn = reinterpret_cast<ggml_backend_score_t>(library_symbol(handle, "ggml_backend_score"));
+        const int score = score_fn ? score_fn() : 0;
+        if (score > best_score) {
+            if (best) {
+                close_library(best);
+            }
+            best       = handle;
+            best_score = score;
+            best_file  = file;
+        } else {
+            close_library(handle);
+        }
+    }
+    if (!best) {
+        return {};
+    }
+    // Stays loaded for the life of the process, as dynamically loaded backends do.
+    auto init_fn = reinterpret_cast<ggml_backend_init_t>(library_symbol(best, "ggml_backend_init"));
+    ggml_backend_reg_t reg = init_fn ? init_fn() : nullptr;
+    if (!reg || reg->api_version != GGML_BACKEND_API_VERSION) {
+        GGML_LOG_ERROR("%s: %s is not a compatible CPU backend\n", __func__, utf8(best_file).c_str());
+        return {};
+    }
+    return { best, reg };
+}
+
+cpu_variant load_variant() {
+    const fs::path dir = this_library_path().parent_path();
+    std::vector<fs::path> files;
+    std::error_code ec;
+    for (fs::directory_iterator it(dir, fs::directory_options::skip_permission_denied, ec), end; !ec && it != end;
+         it.increment(ec)) {
+        if (!variant_name(it->path()).empty()) {
+            files.push_back(it->path());
+        }
+    }
+    std::sort(files.begin(), files.end());
+
+    const char * requested = std::getenv("NEMO_SPEECH_CPU_VARIANT");
+    if (requested && *requested) {
+        std::vector<fs::path> matching;
+        for (const fs::path & file : files) {
+            if (variant_name(file) == requested) {
+                matching.push_back(file);
+            }
+        }
+        cpu_variant variant = load_best(matching);
+        if (variant.reg) {
+            return variant;
+        }
+        GGML_LOG_ERROR("%s: NEMO_SPEECH_CPU_VARIANT=%s is missing or not supported by this CPU; "
+                       "choosing a variant automatically\n", __func__, requested);
+    }
+
+    cpu_variant variant = load_best(files);
+    if (!variant.reg) {
+        GGML_LOG_ERROR("%s: no CPU backend in %s supports this CPU\n", __func__, utf8(dir).c_str());
+    }
+    return variant;
+}
+
+const cpu_variant & variant() {
+    static const cpu_variant loaded = load_variant();
+    return loaded;
+}
+
+void * variant_symbol(const char * name) {
+    const cpu_variant & v = variant();
+    return v.reg ? library_symbol(v.handle, name) : nullptr;
+}
+
+[[noreturn]] void no_variant(const char * name) {
+    GGML_ABORT("%s: no CPU backend variant is available", name);
+}
+
+} // namespace
+
+ggml_backend_reg_t ggml_backend_cpu_reg(void) {
+    return variant().reg;
+}
+
+// Defines `name` to call the function of the same name in the loaded variant,
+// or to run `otherwise` when there is none.
+#define GGML_CPU_FORWARD(ret, name, params, args, otherwise)                            \
+    ret name params {                                                                   \
+        static const auto fn = reinterpret_cast<ret(*) params>(variant_symbol(#name)); \
+        if (!fn) {                                                                      \
+            otherwise;                                                                  \
+        }                                                                               \
+        return fn args;                                                                 \
+    }
+
+#define GGML_CPU_FORWARD_REQUIRED(ret, name, params, args) \
+    GGML_CPU_FORWARD(ret, name, params, args, no_variant(#name))
+
+#define GGML_CPU_FORWARD_HAS(name) GGML_CPU_FORWARD(int, name, (void), (), return 0)
+
+// Everything else ggml-cpu.h declares, in its order.
+GGML_CPU_FORWARD_REQUIRED(void, ggml_numa_init, (enum ggml_numa_strategy numa), (numa))
+GGML_CPU_FORWARD(bool, ggml_is_numa, (void), (), return false)
+
+GGML_CPU_FORWARD_REQUIRED(struct ggml_tensor *, ggml_new_i32, (struct ggml_context * ctx, int32_t value), (ctx, value))
+GGML_CPU_FORWARD_REQUIRED(struct ggml_tensor *, ggml_new_f32, (struct ggml_context * ctx, float value), (ctx, value))
+
+GGML_CPU_FORWARD_REQUIRED(struct ggml_tensor *, ggml_set_i32, (struct ggml_tensor * tensor, int32_t value), (tensor, value))
+GGML_CPU_FORWARD_REQUIRED(struct ggml_tensor *, ggml_set_f32, (struct ggml_tensor * tensor, float value), (tensor, value))
+
+GGML_CPU_FORWARD_REQUIRED(int32_t, ggml_get_i32_1d, (const struct ggml_tensor * tensor, int i), (tensor, i))
+GGML_CPU_FORWARD_REQUIRED(void, ggml_set_i32_1d, (const struct ggml_tensor * tensor, int i, int32_t value),
+                          (tensor, i, value))
+
+GGML_CPU_FORWARD_REQUIRED(int32_t, ggml_get_i32_nd, (const struct ggml_tensor * tensor, int i0, int i1, int i2, int i3),
+                          (tensor, i0, i1, i2, i3))
+GGML_CPU_FORWARD_REQUIRED(void, ggml_set_i32_nd,
+                          (const struct ggml_tensor * tensor, int i0, int i1, int i2, int i3, int32_t value),
+                          (tensor, i0, i1, i2, i3, value))
+
+GGML_CPU_FORWARD_REQUIRED(float, ggml_get_f32_1d, (const struct ggml_tensor * tensor, int i), (tensor, i))
+GGML_CPU_FORWARD_REQUIRED(void, ggml_set_f32_1d, (const struct ggml_tensor * tensor, int i, float value),
+                          (tensor, i, value))
+
+GGML_CPU_FORWARD_REQUIRED(float, ggml_get_f32_nd, (const struct ggml_tensor * tensor, int i0, int i1, int i2, int i3),
+                          (tensor, i0, i1, i2, i3))
+GGML_CPU_FORWARD_REQUIRED(void, ggml_set_f32_nd,
+                          (const struct ggml_tensor * tensor, int i0, int i1, int i2, int i3, float value),
+                          (tensor, i0, i1, i2, i3, value))
+
+GGML_CPU_FORWARD_REQUIRED(struct ggml_threadpool *, ggml_threadpool_new, (struct ggml_threadpool_params * params),
+                          (params))
+GGML_CPU_FORWARD_REQUIRED(void, ggml_threadpool_free, (struct ggml_threadpool * threadpool), (threadpool))
+GGML_CPU_FORWARD_REQUIRED(int, ggml_threadpool_get_n_threads, (struct ggml_threadpool * threadpool), (threadpool))
+GGML_CPU_FORWARD_REQUIRED(void, ggml_threadpool_pause, (struct ggml_threadpool * threadpool), (threadpool))
+GGML_CPU_FORWARD_REQUIRED(void, ggml_threadpool_resume, (struct ggml_threadpool * threadpool), (threadpool))
+
+GGML_CPU_FORWARD_REQUIRED(struct ggml_cplan, ggml_graph_plan,
+                          (const struct ggml_cgraph * cgraph, int n_threads, struct ggml_threadpool * threadpool),
+                          (cgraph, n_threads, threadpool))
+GGML_CPU_FORWARD_REQUIRED(enum ggml_status, ggml_graph_compute, (struct ggml_cgraph * cgraph, struct ggml_cplan * cplan),
+                          (cgraph, cplan))
+GGML_CPU_FORWARD_REQUIRED(enum ggml_status, ggml_graph_compute_with_ctx,
+                          (struct ggml_context * ctx, struct ggml_cgraph * cgraph, int n_threads),
+                          (ctx, cgraph, n_threads))
+
+GGML_CPU_FORWARD_HAS(ggml_cpu_has_sse3)
+GGML_CPU_FORWARD_HAS(ggml_cpu_has_ssse3)
+GGML_CPU_FORWARD_HAS(ggml_cpu_has_avx)
+GGML_CPU_FORWARD_HAS(ggml_cpu_has_avx_vnni)
+GGML_CPU_FORWARD_HAS(ggml_cpu_has_avx2)
+GGML_CPU_FORWARD_HAS(ggml_cpu_has_bmi2)
+GGML_CPU_FORWARD_HAS(ggml_cpu_has_f16c)
+GGML_CPU_FORWARD_HAS(ggml_cpu_has_fma)
+GGML_CPU_FORWARD_HAS(ggml_cpu_has_avx512)
+GGML_CPU_FORWARD_HAS(ggml_cpu_has_avx512_vbmi)
+GGML_CPU_FORWARD_HAS(ggml_cpu_has_avx512_vnni)
+GGML_CPU_FORWARD_HAS(ggml_cpu_has_avx512_bf16)
+GGML_CPU_FORWARD_HAS(ggml_cpu_has_amx_int8)
