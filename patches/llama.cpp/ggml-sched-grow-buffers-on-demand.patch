 #define tensor_id_copy(id, backend_id, copy_id) sched->hv_tensor_copies[(id) * sched->n_backends * sched->n_copies + (backend_id) * sched->n_copies + (copy_id)]
 #define tensor_copy(tensor, backend_id, copy_id) tensor_id_copy(hash_id(tensor), backend_id, copy_id)
 
+// Returns a context with room for one more tensor copy or view of the current
+// split. A single buffer sized up front for graph_size*GGML_SCHED_MAX_SPLIT_INPUTS*2
+// tensors takes about 1.2 GB for a graph_size of 65536, though a split rarely
+// makes more than a few. The chunks are allocated as splits need them instead,
+// and kept until the scheduler is freed: every split reuses them in the same
+// order, so tensors of the previous split stay addressable as in one buffer.
+static struct ggml_context * ggml_backend_sched_ctx(ggml_backend_sched_t sched) {
+    const int n_used = sched->n_ctx_chunks_used;
+    if (n_used == 0 || sched->ctx_chunk_n_tensors == sched->ctx_chunks[n_used - 1].n_tensors) {
+        if (n_used == sched->n_ctx_chunks) {
+            auto * chunks = (struct ggml_backend_sched_ctx_chunk *)
+                realloc(sched->ctx_chunks, (n_used + 1) * sizeof(struct ggml_backend_sched_ctx_chunk));
+            GGML_ASSERT(chunks != NULL);
+            const size_t n_tensors = n_used == 0 ? GGML_SCHED_CTX_CHUNK_TENSORS : 2*chunks[n_used - 1].n_tensors;
+            chunks[n_used].buffer    = (char *) malloc(n_tensors*ggml_tensor_overhead());
+            chunks[n_used].n_tensors = n_tensors;
+            chunks[n_used].ctx       = NULL;
+            GGML_ASSERT(chunks[n_used].buffer != NULL);
+            sched->ctx_chunks   = chunks;
+            sched->n_ctx_chunks = n_used + 1;
+        }
+
+        struct ggml_backend_sched_ctx_chunk * chunk = &sched->ctx_chunks[n_used];
+        struct ggml_init_params params = {
+            /* .mem_size =   */ chunk->n_tensors*ggml_tensor_overhead(),
+            /* .mem_buffer = */ chunk->buffer,
+            /* .no_alloc =   */ true
+        };
+        chunk->ctx = ggml_init(params);
+        if (chunk->ctx == NULL) {
+            GGML_ABORT("%s: failed to initialize context\n", __func__);
+        }
+        sched->n_ctx_chunks_used   = n_used + 1;
+        sched->ctx_chunk_n_tensors = 0;
+    }
+    sched->ctx_chunk_n_tensors++;
+    return sched->ctx_chunks[sched->n_ctx_chunks_used - 1].ctx;
+}
+
+// frees the contexts of the previous split, keeping the chunks for reuse
+static void ggml_backend_sched_ctx_reset(ggml_backend_sched_t sched) {
+    for (int i = 0; i < sched->n_ctx_chunks_used; i++) {
+        ggml_free(sched->ctx_chunks[i].ctx);
+        sched->ctx_chunks[i].ctx = NULL;
+    }
+    sched->n_ctx_chunks_used = 0;
+}
+
+// grows a backend id array, zeroing the new entries as calloc did when the
+// arrays were sized up front
+static void ggml_backend_sched_ids_grow(int ** ids, int old_size, int new_size) {
+    int * pnew = (int *) realloc(*ids, new_size * sizeof(int));
+    GGML_ASSERT(pnew != NULL);
+    memset(pnew + old_size, 0, (new_size - old_size) * sizeof(int));
+    *ids = pnew;
+}
